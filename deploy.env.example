# RELand deploy configuration
# Copy this file to deploy.env and fill in your values. Do NOT commit deploy.env (it may contain secrets).
# The script looks for deploy.env in the project root or in scripts/ .
#
# Usage: cp deploy.env.example deploy.env   then edit deploy.env

# ---------- Common ----------
AWS_REGION=us-east-1

# ---------- Frontend (for ./scripts/deploy_reland.sh --frontend) ----------
# S3 bucket that hosts the React static files (e.g. reland-frontend-ACCOUNT_ID or reland-web-ACCOUNT_ID)
S3_BUCKET=reland-frontend-348170387270
# CloudFront distribution ID (find in CloudFront console)
CLOUDFRONT_DISTRIBUTION_ID=E3MS1AYMUSBSAQ
# Backend API URL - used at build time so the frontend knows where to call the API
REACT_APP_API_URL=https://your-app-runner-url.us-east-1.awsapprunner.com
# Mapbox token for the map (get one at https://account.mapbox.com/)
REACT_APP_MAPBOX_TOKEN=pk.your_mapbox_public_token

# ---------- Backend (for ./scripts/deploy_reland.sh --backend) ----------
# ECR repository name where the backend Docker image is stored
ECR_REPOSITORY=reland-backend
# App Runner service name
APP_RUNNER_SERVICE=reland-backend
# PostgreSQL connection string for RDS (or leave unset to read from Parameter Store /reland/database/url)
# Format: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# DATABASE_URL=postgresql://reland_admin:YOUR_PASSWORD@reland-db.xxxxx.us-east-1.rds.amazonaws.com:5432/reland_db?sslmode=require
# S3 bucket name for trained ML models (or leave unset to read from Parameter Store /reland/s3/models-bucket)
S3_MODELS_BUCKET=reland-models-348170387270
# EC2 launch template name for ML training workers (optional)
EC2_LAUNCH_TEMPLATE_NAME=reland-worker-template
# Flask secret key (optional; change in production)
# SECRET_KEY=your-secret-key
# Google Geocoding API key (optional)
# GOOGLE_GEOCODING_API_KEY=

# ---------- Database seed (for ./scripts/deploy_reland.sh --database) ----------
# RDS URL for setup_rds_database.py (same format as DATABASE_URL above)
# If unset, script tries Parameter Store /reland/database/url
# RDS_URL=postgresql://...

# For --database --local (local PostgreSQL init)
# LOCAL_DATABASE_URL=postgresql://reland_user:your_password@localhost:5432/reland_db
