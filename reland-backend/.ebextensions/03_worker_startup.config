files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_start_worker.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Start RQ worker as a background process
      cd /var/app/current
      source /var/app/venv/*/bin/activate
      
      # Kill existing worker if running
      pkill -f "python.*worker.py" || true
      
      # Start worker in background
      nohup python worker.py > /var/log/worker.log 2>&1 &
      echo $! > /var/run/worker.pid
      
      echo "Worker started with PID: $(cat /var/run/worker.pid)"

  "/opt/elasticbeanstalk/hooks/restartappserver/post/99_start_worker.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Restart worker after app server restart
      cd /var/app/current
      source /var/app/venv/*/bin/activate
      
      # Kill existing worker if running
      pkill -f "python.*worker.py" || true
      
      # Start worker in background
      nohup python worker.py > /var/log/worker.log 2>&1 &
      echo $! > /var/run/worker.pid
      
      echo "Worker restarted with PID: $(cat /var/run/worker.pid)"

option_settings:
  aws:elasticbeanstalk:sqsd:
    # Since we're using Redis Queue, we'll ignore SQS settings
    # The worker will connect directly to Redis
    WorkerQueueURL: ""
    HttpPath: /worker
    MimeType: application/json
