# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database_name
# Use DATABASE_URL for production (RDS); use LOCAL_DATABASE_URL for local development.
DATABASE_URL=postgresql://reland_user:your_password@localhost:5432/reland_db

# Local Database URL (used when FLASK_ENV=local or ENVIRONMENT=local)
LOCAL_DATABASE_URL=postgresql://reland_user:your_password@localhost:5432/reland_db

# Google Geocoding API Key (optional)
GOOGLE_GEOCODING_API_KEY=your_google_api_key_here

# Optional: Redis URL if using background jobs (default: not used)
# REDIS_URL=redis://localhost:6379/0

# Training job timeout in seconds (default 21600 = 6 hours). Increase if full training runs longer.
# TRAINING_TIMEOUT_SECONDS=21600
